# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/content_ops_db"

# JWT
JWT_SECRET=your_super_secure_jwt_secret
JWT_EXPIRES_IN=1d

# Swagger
SWAGGER_TITLE=Content Ops API
